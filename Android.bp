package {
    default_applicable_licenses: ["external_qdl_license"],
}

license {
    name: "external_qdl_license",
    visibility: [":__subpackages__"],
    license_kinds: [
        "SPDX-license-identifier-BSD",
    ],
    license_text: [
        "LICENSE",
    ],
}

cc_defaults {
    name: "qdl_defaults",
    cflags: [
        "-Wall",
        "-Wno-gnu-pointer-arith",
    ],
    shared_libs: [
        "libusb",
        "libxml2",
    ],
    include_dirs: [
        "external/libusb/include/libusb",
    ],
}

cc_binary {
    name: "qdl",
    vendor: true,
    defaults: ["qdl_defaults"],
    srcs: [
        "firehose.c",
        "qdl.c",
        "sahara.c",
        "util.c",
        "patch.c",
        "program.c",
        "read.c",
        "ufs.c",
        "usb.c",
    ],
}

cc_binary {
    name: "qdl-ramdump",
    defaults: ["qdl_defaults"],
    srcs: [
        "ramdump.c",
        "sahara.c",
        "util.c",
        "usb.c",
    ],
}

// The original name of this binary upstream is just 'ks'.
cc_binary {
    name: "qdl-ks",
    defaults: ["qdl_defaults"],
    srcs: [
        "ks.c",
        "sahara.c",
        "util.c",
    ],
}
